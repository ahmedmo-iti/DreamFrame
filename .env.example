# Copy this file to .env.local and adjust for your machine.

# Local ComfyUI origin the dev/production server proxies to.
COMFY_URL=http://127.0.0.1:8188

# Production server (server.mjs) bind host and port.
DREAMFRAME_HOST=127.0.0.1
PORT=3000

# Multi-PC render worker list (see dreamframe-workers.example.json).
DREAMFRAME_WORKERS_FILE=dreamframe-workers.json

# Set to "true" to disable Vite HMR during development.
# DISABLE_HMR=false
